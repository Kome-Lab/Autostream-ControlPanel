{
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "npm run typecheck && next build",
    "preview": "npx serve out",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "node ./node_modules/@typescript/native/bin/tsc --noEmit",
    "test:i18n": "node scripts/test-i18n.mjs",
    "test:metrics": "node --no-warnings --test tests/metric-classification.test.mts",
    "test:oauth-account": "node --no-warnings --test tests/oauth-account.test.mts",
    "test:auth-redirect": "node --no-warnings --test tests/post-login-redirect.test.mts",
    "test:analytics": "node --no-warnings --test tests/google-analytics.test.mts",
    "test:navigation": "node --no-warnings --test tests/navigation-section.test.mts",
    "test:browser-harness": "node --no-warnings --test tests/helpers/browser-launch-profile.test.mts tests/helpers/browser-startup.test.mts tests/helpers/browser-process-attempt.test.mts tests/helpers/browser-request-lifecycle.test.mts",
    "test:ui-foundation-browser": "npm run test:browser-harness && node --no-warnings tests/helpers/run-ui-foundation-browser.mts",
    "test:control-platform": "node --no-warnings --test tests/control-platform-features.test.mts",
    "test:control-platform-browser": "npm run test:ui-foundation-browser",
    "test:service-health": "node --no-warnings --test tests/service-health.test.mts",
    "test:notifications": "node --no-warnings --test tests/notification-channel.test.mts",
    "test:observability-ui": "node --no-warnings --test tests/observability-ui-regressions.test.mts",
    "test:system-updates": "node --no-warnings --test tests/system-updates.test.mts",
    "test:stream-create": "node --no-warnings --test tests/stream-create.test.mts",
    "test:preview": "node --no-warnings --test tests/stream-preview.test.mts",
    "test:stream-regressions": "node --no-warnings --test tests/stream-create.test.mts tests/stream-preview.test.mts tests/archive-artifact-refresh.test.mts tests/resource-page-observability-actions.test.mts tests/stream-static-relay-recovery.test.mts tests/youtube-output-static-relay.test.mts tests/navigation-section.test.mts tests/service-health.test.mts"
  },
