#!/bin/bash
set -euo pipefail

umask 077
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C

readonly SERVICE_NAME="control-panel"
readonly ARTIFACT_PREFIX="autostream-control-panel"
readonly ARTIFACT_MANIFEST_NAME="artifact-manifest.json"
readonly MAX_ARCHIVE_SIZE=268435456
readonly MANAGED_ROOT="/opt/autostream/control-panel"
readonly RELEASES_DIR="${MANAGED_ROOT}/releases"
readonly CURRENT_LINK="${MANAGED_ROOT}/current"
readonly PUBLIC_BINARY="/usr/local/bin/control-panel"
readonly PUBLIC_WEB="/usr/share/autostream-control-panel"
readonly ENV_DEST="/etc/autostream/control-panel.env"
readonly UNIT_DEST="/etc/systemd/system/autostream-control-panel.service"
readonly UNIT_NAME="autostream-control-panel.service"
readonly STATE_DIR="/var/lib/autostream/control-panel"
readonly INSTALL_BACKUP_ROOT="/var/backups/autostream/install-migrations/control-panel"
readonly BACKUP_EXECUTABLE="/usr/local/sbin/autostream-backup-control-panel"
readonly DATABASE_BACKUP_DIR="/var/backups/autostream/control-panel"
readonly MARIADB_DEFAULTS="/etc/autostream-local-executor/mariadb-backup.cnf"

die() {
  printf 'install-autostream-control-panel: %s\n' "$*" >&2
  exit 1
}

[[ ${EUID} -eq 0 ]] || die "must run as root (use sudo)"
[[ $# -eq 0 ]] || die "this installer does not accept arguments"

for command in \
  awk basename chmod chown cmp cp dirname find getent grep groupadd groupdel id install jq \
  flock ln mktemp mv readlink rm rmdir runuser sha256sum sort stat sync systemctl tar uname uniq useradd userdel; do
  command -v "${command}" >/dev/null 2>&1 || die "required command is unavailable: ${command}"
done
[[ -f /usr/bin/mariadb-dump && ! -L /usr/bin/mariadb-dump && -x /usr/bin/mariadb-dump ]] || \
  die "required MariaDB dump executable is missing or unsafe: /usr/bin/mariadb-dump"

require_secure_root_directory() {
  local path=$1
  local mode
  local resolved
  [[ -d ${path} && ! -L ${path} ]] || \
    die "required system directory is missing or unsafe: ${path}"
  resolved="$(readlink -f -- "${path}")" || \
    die "required system directory cannot be resolved: ${path}"
  [[ ${resolved} == "${path}" ]] || \
    die "required system directory does not resolve to its fixed path: ${path}"
  [[ $(stat -c '%U:%G' -- "${path}") == "root:root" ]] || \
    die "required system directory must be owned by root:root: ${path}"
  mode="$(stat -c '%a' -- "${path}")"
  (( (8#${mode} & 07022) == 0 )) || \
    die "required system directory has unsafe mode bits: ${path}"
}

# Reject unsafe immutable anchors before staging or executing any release input.
for fixed_parent in \
  / \
  /opt \
  /usr \
  /usr/local \
  /usr/local/bin \
  /usr/local/sbin \
  /usr/share \
  /etc \
  /etc/systemd \
  /etc/systemd/system \
  /var \
  /var/lib \
  /var/backups \
  /run; do
  require_secure_root_directory "${fixed_parent}"
done

# Reject the specialized state-path type boundary before release processing or
# generic managed-parent validation can obscure it.
if [[ -L ${STATE_DIR} ]]; then
  die "existing service state path is not a safe directory: ${STATE_DIR}"
fi

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)" || \
  die "could not resolve the installer directory"
[[ -n ${SCRIPT_DIR} && -d ${SCRIPT_DIR} && ! -L ${SCRIPT_DIR} ]] || \
  die "installer directory is missing or unsafe"
readonly SCRIPT_DIR
ARTIFACT_ID="$(basename -- "${SCRIPT_DIR}")" || die "could not resolve the release directory name"
readonly ARTIFACT_ID
if [[ ! ${ARTIFACT_ID} =~ ^autostream-control-panel_(v[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z]+(\.[0-9A-Za-z]+)*)?)_linux_(amd64|arm64)$ ]]; then
  die "the extracted directory name is invalid: ${ARTIFACT_ID}"
fi
readonly VERSION="${BASH_REMATCH[1]}"
readonly ARCH="${BASH_REMATCH[4]}"

case "$(uname -m)" in
  x86_64) readonly HOST_ARCH="amd64" ;;
  aarch64|arm64) readonly HOST_ARCH="arm64" ;;
  *) die "unsupported host architecture: $(uname -m)" ;;
esac
[[ ${ARCH} == "${HOST_ARCH}" ]] || die "artifact architecture ${ARCH} does not match host ${HOST_ARCH}"

ARTIFACT_PARENT="$(dirname -- "${SCRIPT_DIR}")" || die "could not resolve the release parent directory"
readonly ARTIFACT_PARENT
readonly ARCHIVE_NAME="${ARTIFACT_ID}.tar.gz"
readonly ARCHIVE_SOURCE="${ARTIFACT_PARENT}/${ARCHIVE_NAME}"

[[ -f ${ARCHIVE_SOURCE} && ! -L ${ARCHIVE_SOURCE} ]] || \
  die "required release archive is missing or unsafe: ${ARCHIVE_SOURCE}"
ARTIFACT_SOURCE_SIZE="$(stat -c %s -- "${ARCHIVE_SOURCE}")" || \
  die "could not determine the source archive size"
[[ ${ARTIFACT_SOURCE_SIZE} =~ ^[1-9][0-9]*$ ]] || die "source archive size is invalid"
[[ ${ARTIFACT_SOURCE_SIZE} -le ${MAX_ARCHIVE_SIZE} ]] || \
  die "source archive exceeds the ${MAX_ARCHIVE_SIZE}-byte limit"
readonly ARTIFACT_SOURCE_SIZE

cleanup_running=false
signal_transaction_active=false
deferred_termination_status=0

handle_installer_signal() {
  local status=$1
  if [[ ${cleanup_running} == true ]]; then
    trap '' HUP INT TERM
    return
  fi
  if [[ ${signal_transaction_active} == true ]]; then
    if [[ ${deferred_termination_status} -eq 0 ]]; then
      deferred_termination_status="${status}"
    fi
    return
  fi
  trap '' HUP INT TERM
  exit "${status}"
}

restore_installer_signal_traps() {
  if [[ ${cleanup_running} == true ]]; then
    trap '' HUP INT TERM
  else
    trap 'handle_installer_signal 129' HUP
    trap 'handle_installer_signal 130' INT
    trap 'handle_installer_signal 143' TERM
  fi
}

begin_installer_signal_transaction() {
  [[ ${signal_transaction_active} == false ]] || \
    die "nested installer signal transaction is not allowed"
  signal_transaction_active=true
}

finish_installer_signal_transaction() {
  local pending_status
  signal_transaction_active=false
  pending_status="${deferred_termination_status}"
  deferred_termination_status=0
  if [[ ${pending_status} -ne 0 ]]; then
    handle_installer_signal "${pending_status}"
  fi
}

INPUT_STAGE=""
INPUT_STAGE_IDENTITY=""

input_stage_is_owned() {
  [[ -n ${INPUT_STAGE} &&
    -n ${INPUT_STAGE_IDENTITY} &&
    -d ${INPUT_STAGE} &&
    ! -L ${INPUT_STAGE} &&
    $(readlink -f -- "${INPUT_STAGE}") == "${INPUT_STAGE}" &&
    $(stat -c '%d:%i' -- "${INPUT_STAGE}") == "${INPUT_STAGE_IDENTITY}" ]]
}

cleanup_early_input_stage() {
  trap '' HUP INT TERM
  cleanup_running=true
  signal_transaction_active=false
  deferred_termination_status=0
  trap - EXIT
  local status=$1
  set +e
  if [[ -z ${INPUT_STAGE} ]]; then
    :
  elif input_stage_is_owned; then
    rm -rf -- "${INPUT_STAGE}"
  else
    printf 'install-autostream-control-panel: refusing to remove replaced private input staging\n' >&2
    status=1
  fi
  exit "${status}"
}

trap 'cleanup_early_input_stage "$?"' EXIT
restore_installer_signal_traps

# The private recovery root is created before the full rollback journal exists.
# Defer termination until its exact inode is captured and the early EXIT cleanup
# can remove it without guessing ownership.
input_stage_status=0
begin_installer_signal_transaction
if INPUT_STAGE="$(mktemp -d /var/tmp/autostream-control-panel-install.XXXXXXXX)"; then
  :
else
  input_stage_status=$?
fi
if [[ -n ${INPUT_STAGE} &&
  ${INPUT_STAGE} == /var/tmp/autostream-control-panel-install.* &&
  -d ${INPUT_STAGE} &&
  ! -L ${INPUT_STAGE} &&
  $(readlink -f -- "${INPUT_STAGE}") == "${INPUT_STAGE}" &&
  $(stat -c '%U:%G:%a' -- "${INPUT_STAGE}") == "root:root:700" ]]; then
  INPUT_STAGE_IDENTITY="$(stat -c '%d:%i' -- "${INPUT_STAGE}")"
elif [[ ${input_stage_status} -eq 0 ]]; then
  input_stage_status=1
fi
finish_installer_signal_transaction
[[ ${input_stage_status} -eq 0 ]] || \
  die "could not create the private input staging directory safely (mktemp status ${input_stage_status})"
readonly INPUT_STAGE
readonly INPUT_STAGE_IDENTITY
readonly UNPACK_DIR="${INPUT_STAGE}/unpack"

managed_candidate=""
installation_complete=false
current_changed=false
previous_current_target=""
unit_stage=""
backup_exec_stage=""
env_stage=""
backup_config_stage=""
unit_changed=false
backup_exec_changed=false
env_created=false
backup_config_created=false
unit_previous_kind="absent"
backup_exec_previous_kind="absent"
unit_install_needed=true
backup_exec_install_needed=true
unit_backup=""
backup_exec_backup=""
unit_backup_created=false
unit_backup_identity=""
backup_exec_backup_created=false
backup_exec_backup_identity=""
service_user_created=false
service_group_created=false
created_service_uid=""
created_service_gid=""
release_dir_created=false
release_dir_created_identity=""
lock_create_stage=""
shared_lock_opened=false
target_lock_opened=false
current_next=""
current_next_identity=""
current_next_target=""
public_next=""
public_next_identity=""
public_next_target=""
declare -a changed_public_paths=()
declare -a previous_public_kinds=()
declare -a previous_public_targets=()
declare -a previous_public_backups=()
declare -a previous_public_backup_created=()
declare -a previous_public_backup_identities=()
declare -a previous_public_backup_metadata=()
declare -a previous_public_backup_sha256=()
declare -a previous_public_uids=()
declare -a previous_public_gids=()
declare -a previous_public_modes=()
declare -a previous_public_sha256=()
declare -a prepared_directory_paths=()
declare -a prepared_directory_existed=()
declare -a prepared_directory_identities=()
declare -a prepared_directory_uids=()
declare -a prepared_directory_gids=()
declare -a prepared_directory_modes=()
declare -A prepared_directory_seen=()
declare -a created_backup_paths=()
declare -a created_backup_identities=()
declare -A preexisting_public_backup_identities=()
declare -A preexisting_public_backup_metadata=()
declare -A preexisting_public_backup_sha256=()
last_created_backup_identity=""

sync_installer_filesystems() {
  local path
  local failed=false
  for path in \
    "${MANAGED_ROOT}" \
    /usr/local/bin \
    /usr/local/sbin \
    /usr/share \
    /etc/systemd/system \
    /etc/autostream \
    /etc/autostream-local-executor \
    /var/backups/autostream; do
    if [[ -d ${path} && ! -L ${path} ]]; then
      sync -f "${path}" || failed=true
    fi
  done
  [[ ${failed} == false ]]
}

create_journaled_temporary_path() {
  local output_variable=$1
  local path_kind=$2
  local template=$3
  local path=""
  local create_status=0

  # mktemp and publishing its path to the parent-shell rollback journal are one
  # deferred-signal transaction. This helper must be called directly, never from
  # command substitution, or the by-reference journal update would be lost.
  begin_installer_signal_transaction
  if [[ ${path_kind} == "directory" ]]; then
    if path="$(mktemp -d "${template}")"; then
      [[ -d ${path} && ! -L ${path} ]] || create_status=1
    else
      create_status=$?
    fi
  elif [[ ${path_kind} == "file" ]]; then
    if path="$(mktemp "${template}")"; then
      [[ -f ${path} && ! -L ${path} ]] || create_status=1
    else
      create_status=$?
    fi
  else
    create_status=1
  fi
  if [[ -n ${path} &&
    ( ( ${path_kind} == "directory" && -d ${path} && ! -L ${path} ) ||
      ( ${path_kind} == "file" && -f ${path} && ! -L ${path} ) ) ]]; then
    printf -v "${output_variable}" '%s' "${path}"
  elif [[ ${create_status} -eq 0 ]]; then
    create_status=1
  fi
  finish_installer_signal_transaction
  [[ ${create_status} -eq 0 ]]
}

prepare_install_directory() {
  local path=$1
  local owner=$2
  local group=$3
  local requested_mode=$4
  local expected_mode="${requested_mode#0}"
  local existed=false
  local identity=""
  local uid=""
  local gid=""
  local mode=""
  if [[ -n ${prepared_directory_seen["${path}"]+present} ]]; then
    [[ -d ${path} && ! -L ${path} ]] || \
      die "prepared installer directory changed type: ${path}"
    [[ $(stat -c '%U:%G:%a' -- "${path}") == "${owner}:${group}:${expected_mode}" ]] || \
      die "prepared installer directory changed ownership or mode: ${path}"
    return
  fi
  if [[ -e ${path} || -L ${path} ]]; then
    [[ -d ${path} && ! -L ${path} ]] || \
      die "installer directory destination is not a safe directory: ${path}"
    [[ $(readlink -f -- "${path}") == "${path}" ]] || \
      die "installer directory destination does not resolve to its fixed path: ${path}"
    existed=true
    identity="$(stat -c '%d:%i' -- "${path}")"
    uid="$(stat -c '%u' -- "${path}")"
    gid="$(stat -c '%g' -- "${path}")"
    mode="$(stat -c '%a' -- "${path}")"
  fi
  local install_status=0
  # The journal append, directory mutation, and new inode capture must be
  # indivisible with respect to HUP/INT/TERM.
  begin_installer_signal_transaction
  prepared_directory_paths+=("${path}")
  prepared_directory_existed+=("${existed}")
  prepared_directory_identities+=("${identity}")
  prepared_directory_uids+=("${uid}")
  prepared_directory_gids+=("${gid}")
  prepared_directory_modes+=("${mode}")
  prepared_directory_seen["${path}"]=1
  if install -d -o "${owner}" -g "${group}" -m "${requested_mode}" "${path}"; then
    :
  else
    install_status=$?
    if [[ ${existed} == false &&
      -d ${path} &&
      ! -L ${path} &&
      $(readlink -f -- "${path}" 2>/dev/null || true) == "${path}" ]]; then
      prepared_directory_identities[${#prepared_directory_identities[@]}-1]="$(stat -c '%d:%i' -- "${path}")"
    fi
  fi
  if [[ ${install_status} -eq 0 && ${existed} == false ]]; then
    prepared_directory_identities[${#prepared_directory_identities[@]}-1]="$(stat -c '%d:%i' -- "${path}")"
  fi
  finish_installer_signal_transaction
  [[ ${install_status} -eq 0 ]] || return "${install_status}"
  [[ -d ${path} && ! -L ${path} && $(readlink -f -- "${path}") == "${path}" ]] || \
    die "prepared installer directory is missing or unsafe: ${path}"
  [[ $(stat -c '%U:%G:%a' -- "${path}") == "${owner}:${group}:${expected_mode}" ]] || \
    die "prepared installer directory ownership or mode is invalid: ${path}"
}

rollback_prepared_directories() {
  local index
  local path
  local existed
  local identity
  local uid
  local gid
  local mode
  local failed=false
  for ((index=${#prepared_directory_paths[@]} - 1; index >= 0; index--)); do
    path="${prepared_directory_paths[index]}"
    existed="${prepared_directory_existed[index]}"
    identity="${prepared_directory_identities[index]}"
    uid="${prepared_directory_uids[index]}"
    gid="${prepared_directory_gids[index]}"
    mode="${prepared_directory_modes[index]}"
    if [[ ! -d ${path} || -L ${path} ||
      $(stat -c '%d:%i' -- "${path}" 2>/dev/null || true) != "${identity}" ]]; then
      printf 'install-autostream-control-panel: rollback refused changed installer directory: %s\n' \
        "${path}" >&2
      failed=true
      continue
    fi
    if [[ ${existed} == true ]]; then
      chown "${uid}:${gid}" "${path}" || failed=true
      chmod "${mode}" "${path}" || failed=true
      [[ $(stat -c '%u:%g:%a' -- "${path}" 2>/dev/null || true) == "${uid}:${gid}:${mode}" ]] || \
        failed=true
    elif ! rmdir -- "${path}"; then
      printf 'install-autostream-control-panel: rollback could not remove new installer directory: %s\n' \
        "${path}" >&2
      failed=true
    fi
  done
  [[ ${failed} == false ]]
}

rollback_created_release() {
  [[ ${release_dir_created} == true ]] || return 0
  if [[ ! -e ${RELEASE_DIR-} && ! -L ${RELEASE_DIR-} ]]; then
    return 0
  fi
  [[ -n ${RELEASE_DIR-} &&
    ${RELEASE_DIR} == "${RELEASES_DIR}/"* &&
    -d ${RELEASE_DIR} &&
    ! -L ${RELEASE_DIR} &&
    $(stat -c '%d:%i' -- "${RELEASE_DIR}" 2>/dev/null || true) == "${release_dir_created_identity}" ]] || \
    return 1
  rm -rf -- "${RELEASE_DIR}"
  [[ ! -e ${RELEASE_DIR} && ! -L ${RELEASE_DIR} ]]
}

rollback_created_service_account() {
  local failed=false
  if [[ ${service_user_created} == true ]]; then
    if ! id autostream >/dev/null 2>&1 ||
      [[ $(id -u autostream 2>/dev/null || true) != "${created_service_uid}" ]]; then
      failed=true
    elif ! userdel autostream; then
      failed=true
    fi
  fi
  if [[ ${service_group_created} == true ]]; then
    if ! getent group autostream >/dev/null 2>&1 ||
      [[ $(getent group autostream | awk -F: 'NR == 1 { print $3 }') != "${created_service_gid}" ]]; then
      failed=true
    elif ! groupdel autostream; then
      failed=true
    fi
  fi
  [[ ${failed} == false ]]
}

record_created_backup() {
  local path=$1
  [[ -f ${path} && ! -L ${path} ]] || die "created install backup is missing or unsafe: ${path}"
  last_created_backup_identity="$(stat -c '%d:%i' -- "${path}")"
  created_backup_paths+=("${path}")
  created_backup_identities+=("${last_created_backup_identity}")
}

copy_created_backup_and_record() {
  local source=$1
  local destination=$2
  local copy_status=0

  # Copying an absent backup and claiming its inode in the rollback journal are
  # one deferred-signal transaction. A command that reports failure after
  # creating the file is still journaled for safe cleanup.
  begin_installer_signal_transaction
  if cp -a -- "${source}" "${destination}"; then
    :
  else
    copy_status=$?
  fi
  if [[ -f ${destination} && ! -L ${destination} ]]; then
    record_created_backup "${destination}"
  elif [[ ${copy_status} -eq 0 ]]; then
    copy_status=1
  fi
  finish_installer_signal_transaction
  [[ ${copy_status} -eq 0 ]]
}

remove_created_backups() {
  local index
  local path
  local identity
  local failed=false
  for ((index=${#created_backup_paths[@]} - 1; index >= 0; index--)); do
    path="${created_backup_paths[index]}"
    identity="${created_backup_identities[index]}"
    if [[ ! -e ${path} && ! -L ${path} ]]; then
      continue
    fi
    if [[ -f ${path} &&
      ! -L ${path} &&
      $(stat -c '%d:%i' -- "${path}" 2>/dev/null || true) == "${identity}" ]]; then
      rm -f -- "${path}" || failed=true
    else
      failed=true
    fi
  done
  [[ ${failed} == false ]]
}

remove_pending_link() {
  local path=$1
  local identity=$2
  local target=$3
  [[ -n ${path} ]] || return 0
  if [[ ! -e ${path} && ! -L ${path} ]]; then
    return 0
  fi
  [[ -n ${identity} &&
    -L ${path} &&
    $(stat -c '%d:%i' -- "${path}" 2>/dev/null || true) == "${identity}" &&
    $(readlink -- "${path}" 2>/dev/null || true) == "${target}" ]] || return 1
  rm -f -- "${path}"
  [[ ! -e ${path} && ! -L ${path} ]]
}

rollback_public_links() {
  local index
  local path
  local kind
  local target
  local backup
  local backup_created
  local backup_identity
  local backup_metadata
  local backup_sha256
  local previous_uid
  local previous_gid
  local previous_mode
  local previous_sha256
  local rollback_next
  local failed=false
  for ((index=${#changed_public_paths[@]} - 1; index >= 0; index--)); do
    path="${changed_public_paths[index]}"
    kind="${previous_public_kinds[index]}"
    target="${previous_public_targets[index]}"
    backup="${previous_public_backups[index]}"
    backup_created="${previous_public_backup_created[index]}"
    backup_identity="${previous_public_backup_identities[index]}"
    backup_metadata="${previous_public_backup_metadata[index]}"
    backup_sha256="${previous_public_backup_sha256[index]}"
    previous_uid="${previous_public_uids[index]}"
    previous_gid="${previous_public_gids[index]}"
    previous_mode="${previous_public_modes[index]}"
    previous_sha256="${previous_public_sha256[index]}"
    case "${kind}" in
      file)
        if [[ -n ${backup_identity} &&
          -f ${backup} &&
          ! -L ${backup} &&
          $(stat -c '%d:%i' -- "${backup}" 2>/dev/null || true) == "${backup_identity}" &&
          $(stat -c '%u:%g:%a' -- "${backup}" 2>/dev/null || true) == "${backup_metadata}" &&
          $(sha256sum -- "${backup}" 2>/dev/null | awk 'NR == 1 { print $1 }') == \
            "${backup_sha256}" ]]; then
          rollback_next="${path}.rollback.$$"
          rm -f -- "${rollback_next}" || failed=true
          cp -a -- "${backup}" "${rollback_next}" || failed=true
          sync -f "$(dirname -- "${path}")" || failed=true
          mv -Tf -- "${rollback_next}" "${path}" || failed=true
          [[ -f ${path} && ! -L ${path} ]] || failed=true
          cmp -s -- "${path}" "${backup}" || failed=true
          [[ $(stat -c '%u:%g:%a' -- "${path}" 2>/dev/null || true) == \
            "${previous_uid}:${previous_gid}:${previous_mode}" ]] || failed=true
          [[ $(sha256sum -- "${path}" 2>/dev/null | awk 'NR == 1 { print $1 }') == \
            "${previous_sha256}" ]] || failed=true
          if [[ ${backup_created} == true ]]; then
            rm -f -- "${backup}" || failed=true
            [[ ! -e ${backup} && ! -L ${backup} ]] || failed=true
            sync -f "$(dirname -- "${backup}")" || failed=true
          else
            [[ $(stat -c '%d:%i' -- "${backup}" 2>/dev/null || true) == \
              "${backup_identity}" ]] || failed=true
            [[ $(stat -c '%u:%g:%a' -- "${backup}" 2>/dev/null || true) == \
              "${backup_metadata}" ]] || failed=true
            [[ $(sha256sum -- "${backup}" 2>/dev/null | awk 'NR == 1 { print $1 }') == \
              "${backup_sha256}" ]] || failed=true
          fi
        else
          failed=true
        fi
        ;;
      directory)
        if [[ ${backup_created} == true &&
          -n ${backup_identity} &&
          -d ${backup} &&
          ! -L ${backup} &&
          $(stat -c '%d:%i' -- "${backup}" 2>/dev/null || true) == "${backup_identity}" ]]; then
          rm -f -- "${path}" || failed=true
          mv -T -- "${backup}" "${path}" || failed=true
          [[ -d ${path} && ! -L ${path} ]] || failed=true
        elif [[ -d ${path} && ! -L ${path} ]]; then
          :
        else
          failed=true
        fi
        ;;
      symlink)
        rollback_next="${path}.rollback.$$"
        rm -f -- "${rollback_next}" || failed=true
        ln -s -- "${target}" "${rollback_next}" || failed=true
        mv -Tf -- "${rollback_next}" "${path}" || failed=true
        [[ -L ${path} && $(readlink -- "${path}") == "${target}" ]] || failed=true
        ;;
      absent)
        rm -f -- "${path}" || failed=true
        [[ ! -e ${path} && ! -L ${path} ]] || failed=true
        ;;
      *)
        failed=true
        ;;
    esac
  done
  [[ ${failed} == false ]]
}

rollback_current_link() {
  local rollback_next
  [[ ${current_changed} == true ]] || return 0
  if [[ -n ${previous_current_target} ]]; then
    rollback_next="${MANAGED_ROOT}/.current.rollback.$$"
    rm -f -- "${rollback_next}" || return 1
    ln -s -- "${previous_current_target}" "${rollback_next}" || return 1
    mv -Tf -- "${rollback_next}" "${CURRENT_LINK}" || return 1
    [[ -L ${CURRENT_LINK} &&
      $(readlink -- "${CURRENT_LINK}") == "${previous_current_target}" ]] || return 1
  else
    rm -f -- "${CURRENT_LINK}" || return 1
    [[ ! -e ${CURRENT_LINK} && ! -L ${CURRENT_LINK} ]] || return 1
  fi
}

rollback_regular_destination() {
  local destination=$1
  local changed=$2
  local previous_kind=$3
  local backup=$4
  local backup_created=$5
  local backup_identity=$6
  local rollback_next
  [[ ${changed} == true ]] || return 0
  if [[ ${previous_kind} == "regular" &&
    -n ${backup_identity} &&
    -f ${backup} &&
    ! -L ${backup} &&
    $(stat -c '%d:%i' -- "${backup}" 2>/dev/null || true) == "${backup_identity}" ]]; then
    rollback_next="${destination}.rollback.$$"
    rm -f -- "${rollback_next}" || return 1
    cp -a -- "${backup}" "${rollback_next}" || return 1
    sync -f "$(dirname -- "${destination}")" || return 1
    mv -Tf -- "${rollback_next}" "${destination}" || return 1
    [[ -f ${destination} && ! -L ${destination} ]] || return 1
    cmp -s -- "${destination}" "${backup}" || return 1
    if [[ ${backup_created} == true ]]; then
      rm -f -- "${backup}" || return 1
      [[ ! -e ${backup} && ! -L ${backup} ]] || return 1
      sync -f "$(dirname -- "${backup}")" || return 1
    else
      [[ $(stat -c '%d:%i' -- "${backup}" 2>/dev/null || true) == \
        "${backup_identity}" ]] || return 1
    fi
  elif [[ ${previous_kind} == "absent" ]]; then
    rm -f -- "${destination}" || return 1
    [[ ! -e ${destination} && ! -L ${destination} ]] || return 1
  else
    return 1
  fi
}

cleanup() {
  trap '' HUP INT TERM
  cleanup_running=true
  signal_transaction_active=false
  deferred_termination_status=0
  trap - EXIT
  local exit_code=$1
  local rollback_failed=false
  local recovery_evidence_ready=true
  set +e
  if [[ ${installation_complete} != true ]]; then
    if ! rollback_regular_destination \
      "${UNIT_DEST}" \
      "${unit_changed}" \
      "${unit_previous_kind}" \
      "${unit_backup}" \
      "${unit_backup_created}" \
      "${unit_backup_identity}"; then
      rollback_failed=true
    fi
    if ! rollback_regular_destination \
      "${BACKUP_EXECUTABLE}" \
      "${backup_exec_changed}" \
      "${backup_exec_previous_kind}" \
      "${backup_exec_backup}" \
      "${backup_exec_backup_created}" \
      "${backup_exec_backup_identity}"; then
      rollback_failed=true
    fi
    if [[ ${env_created} == true ]]; then
      rm -f -- "${ENV_DEST}" || rollback_failed=true
      [[ ! -e ${ENV_DEST} && ! -L ${ENV_DEST} ]] || rollback_failed=true
    fi
    if [[ ${backup_config_created} == true ]]; then
      rm -f -- "${MARIADB_DEFAULTS}" || rollback_failed=true
      [[ ! -e ${MARIADB_DEFAULTS} && ! -L ${MARIADB_DEFAULTS} ]] || rollback_failed=true
    fi
    if ! rollback_public_links; then
      rollback_failed=true
    fi
    if ! rollback_current_link; then
      rollback_failed=true
    fi
    if ! remove_pending_link \
      "${current_next}" "${current_next_identity}" "${current_next_target}"; then
      rollback_failed=true
    fi
    if ! remove_pending_link \
      "${public_next}" "${public_next_identity}" "${public_next_target}"; then
      rollback_failed=true
    fi
    if ! rollback_created_release; then
      rollback_failed=true
    fi
    if [[ ${unit_changed} == true ]] &&
      ! systemctl daemon-reload >/dev/null 2>&1; then
      rollback_failed=true
    fi
  fi
  if [[ -n ${managed_candidate} && -e ${managed_candidate} ]]; then
    rm -rf -- "${managed_candidate}"
  fi
  rm -f -- \
    "${unit_stage}" \
    "${backup_exec_stage}" \
    "${env_stage}" \
    "${backup_config_stage}" \
    "${lock_create_stage}"
  if [[ ${installation_complete} != true ]]; then
    if [[ ${rollback_failed} == false ]] && ! remove_created_backups; then
      rollback_failed=true
    fi
    if ! rollback_prepared_directories; then
      rollback_failed=true
    fi
    if ! rollback_created_service_account; then
      rollback_failed=true
    fi
    if ! sync_installer_filesystems; then
      rollback_failed=true
    fi
    if [[ ${target_lock_opened} == true ]]; then
      exec 9>&-
      target_lock_opened=false
    fi
    if [[ ${shared_lock_opened} == true ]]; then
      exec 8>&-
      shared_lock_opened=false
    fi
  fi
  if [[ ${rollback_failed} == true ]]; then
    if ! {
      printf 'service=%s\n' "${SERVICE_NAME}"
      printf 'unit_backup=%s\n' "${unit_backup}"
      printf 'backup_executable_backup=%s\n' "${backup_exec_backup}"
      printf 'previous_current_target=%s\n' "${previous_current_target}"
      printf 'legacy_backup_directory=%s\n' "${LEGACY_BACKUP_DIR-}"
    } > "${INPUT_STAGE}/recovery-state.txt"; then
      recovery_evidence_ready=false
    fi
    chown -R root:root "${INPUT_STAGE}" || recovery_evidence_ready=false
    chmod -R go-rwx "${INPUT_STAGE}" || recovery_evidence_ready=false
    [[ -f ${INPUT_STAGE}/recovery-state.txt && ! -L ${INPUT_STAGE}/recovery-state.txt ]] || \
      recovery_evidence_ready=false
    sync -f "${INPUT_STAGE}" || recovery_evidence_ready=false
    if [[ ${recovery_evidence_ready} == true ]]; then
      printf 'install-autostream-control-panel: rollback was incomplete; root-only recovery evidence is retained at %s\n' \
        "${INPUT_STAGE}" >&2
    else
      printf 'install-autostream-control-panel: WARNING: rollback was incomplete and recovery evidence could not be fully sealed; inspect %s immediately\n' \
        "${INPUT_STAGE}" >&2
    fi
  else
    if input_stage_is_owned; then
      rm -rf -- "${INPUT_STAGE}"
    else
      printf 'install-autostream-control-panel: refusing to remove replaced private input staging\n' >&2
      exit_code=1
    fi
  fi
  exit "${exit_code}"
}
