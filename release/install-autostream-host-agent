validate_existing() {
  local path=$1
  local owner=$2
  local group=$3
  local mode=$4
  local label=$5
  [[ ! -e ${path} && ! -L ${path} ]] && return 1
  [[ -f ${path} && ! -L ${path} ]] || die "existing ${label} must be a regular non-symlink file"
  [[ $(stat -c '%U:%G:%a' -- "${path}") == "${owner}:${group}:${mode}" ]] || \
    die "existing ${label} must be ${owner}:${group} ${mode}"
  return 0
}

retire_legacy_identity() {
  local size
  local blocks
  local wipe_failed=false
  validate_existing "${LEGACY_CONFIG_DEST}" root "${AGENT_GROUP}" 640 "legacy identity config" >/dev/null
  [[ $(stat -c '%d:%i:%s:%Y:%f:%u:%g' -- "${LEGACY_CONFIG_DEST}") == "${legacy_config_identity}" &&
    $(sha256sum -- "${LEGACY_CONFIG_DEST}" | awk 'NR == 1 { print $1 }') == "${legacy_config_sha256}" ]] || \
    die "legacy Host Agent identity changed before retirement"
  size=$(stat -c '%s' -- "${LEGACY_CONFIG_DEST}")
  [[ ${size} =~ ^[1-9][0-9]*$ && ${size} -le 65536 ]] || \
    die "legacy Host Agent identity has an unsafe size"
  blocks=$(( (size + 4095) / 4096 ))
  dd if=/dev/zero of="${LEGACY_CONFIG_DEST}" bs=4096 count="${blocks}" conv=notrunc status=none ||
    wipe_failed=true
  sync -d "${LEGACY_CONFIG_DEST}" >/dev/null 2>&1 || wipe_failed=true
  rm -f -- "${LEGACY_CONFIG_DEST}" || \
    die "could not unlink the retired legacy Host Agent identity; the new identity remains installed and the service stays stopped"
  sync -f /etc/autostream
  [[ ! -e ${LEGACY_CONFIG_DEST} && ! -L ${LEGACY_CONFIG_DEST} ]] || \
    die "legacy Host Agent identity survived retirement; the new identity remains installed and the service stays stopped"
  legacy_config_retired=true
  if [[ ${wipe_failed} == true ]]; then
    printf '%s\n' 'install-autostream-host-agent: warning: legacy identity was unlinked, but its best-effort overwrite or sync was incomplete' >&2
  fi
}

validate_managed_agent_link() {
  [[ -L ${BINARY_DEST} ]] || return 1
  [[ -L ${HOST_RUNTIME_CURRENT} ]] || \
    die "managed Host Agent binary is missing the atomic current link"
  local current_target
  current_target=$(readlink -- "${HOST_RUNTIME_CURRENT}")
  [[ ${current_target} == "slots/a" || ${current_target} == "slots/b" ]] || \
    die "managed Host Agent current link points outside its fixed A/B slots"
  [[ $(readlink -- "${BINARY_DEST}") == "${HOST_RUNTIME_CURRENT}/bin/autostream-host-agent" ]] || \
    die "managed Host Agent binary link points outside the atomic current runtime"
  local resolved
  resolved=$(readlink -f -- "${BINARY_DEST}")
  [[ ${resolved} == "${HOST_RUNTIME_SLOTS}/a/bin/autostream-host-agent" ||
    ${resolved} == "${HOST_RUNTIME_SLOTS}/b/bin/autostream-host-agent" ]] || \
    die "managed Host Agent binary resolves outside its fixed A/B slots"
  [[ -f ${resolved} && ! -L ${resolved} ]] || \
    die "managed Host Agent active binary is missing or unsafe"
  [[ $(stat -c '%U:%G:%a' -- "${resolved}") == "root:root:755" ]] || \
    die "managed Host Agent active binary must be root:root 0755"
  return 0
}

