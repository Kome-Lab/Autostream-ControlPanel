if [[ ${local_executor_socket_existed} == true ]]; then
  local_executor_socket_backup=$(mktemp /etc/systemd/system/.autostream-local-executor.socket.backup.XXXXXX)
  rm -f -- "${local_executor_socket_backup}"
  mv -- "${LOCAL_EXECUTOR_SOCKET_DEST}" "${local_executor_socket_backup}"
  local_executor_socket_backed_up=true
fi
if [[ ${local_executor_tmpfiles_existed} == true ]]; then
  local_executor_tmpfiles_backup=$(mktemp /etc/tmpfiles.d/.autostream-local-executor.conf.backup.XXXXXX)
  rm -f -- "${local_executor_tmpfiles_backup}"
  mv -- "${LOCAL_EXECUTOR_TMPFILES_DEST}" "${local_executor_tmpfiles_backup}"
  local_executor_tmpfiles_backed_up=true
fi
if [[ ${self_update_recovery_service_existed} == true ]]; then
  self_update_recovery_service_backup=$(mktemp /etc/systemd/system/.autostream-host-self-update-recovery.service.backup.XXXXXX)
  rm -f -- "${self_update_recovery_service_backup}"
  mv -- "${SELF_UPDATE_RECOVERY_SERVICE_DEST}" "${self_update_recovery_service_backup}"
  self_update_recovery_service_backed_up=true
fi
if [[ ${self_update_recovery_timer_existed} == true ]]; then
  self_update_recovery_timer_backup=$(mktemp /etc/systemd/system/.autostream-host-self-update-recovery.timer.backup.XXXXXX)
  rm -f -- "${self_update_recovery_timer_backup}"
  mv -- "${SELF_UPDATE_RECOVERY_TIMER_DEST}" "${self_update_recovery_timer_backup}"
  self_update_recovery_timer_backed_up=true
fi

if [[ ${install_mode} == "configured" ]]; then
  mv -f -- "${config_stage}" "${CONFIG_DEST}"
  config_installed=true
  sync -f "${CONFIG_DIR}"
fi
if [[ ${install_mode} == "prepare" ]]; then
  install -d -o root -g root -m 0755 \
    "${HOST_RUNTIME_ROOT}" \
    "${HOST_RUNTIME_SLOTS}" \
    "${HOST_RUNTIME_INITIAL_SLOT}" \
    "${HOST_RUNTIME_INITIAL_SLOT}/bin"
  self_update_layout_created=true
  mv -f -- "${binary_stage}" "${HOST_RUNTIME_AGENT}"
  mv -f -- "${local_executor_binary_stage}" "${HOST_RUNTIME_EXECUTOR}"
  ln -s "slots/a" "${HOST_RUNTIME_CURRENT}"
  ln -s "${HOST_RUNTIME_CURRENT}/bin/autostream-host-agent" "${BINARY_DEST}"
  binary_installed=true
  ln -s "${HOST_RUNTIME_CURRENT}/bin/autostream-local-executor" "${LOCAL_EXECUTOR_BINARY_DEST}"
  local_executor_binary_installed=true
elif [[ ${binary_managed_link} == true ]]; then
  rm -f -- "${binary_stage}"
else
  mv -f -- "${binary_stage}" "${BINARY_DEST}"
  binary_installed=true
fi
mv -f -- "${unit_stage}" "${UNIT_DEST}"
unit_installed=true
if [[ ${install_mode} == "prepare" ]]; then
  mv -f -- "${local_executor_service_stage}" "${LOCAL_EXECUTOR_SERVICE_DEST}"
  local_executor_service_installed=true
  mv -f -- "${local_executor_socket_stage}" "${LOCAL_EXECUTOR_SOCKET_DEST}"
  local_executor_socket_installed=true
  mv -f -- "${local_executor_tmpfiles_stage}" "${LOCAL_EXECUTOR_TMPFILES_DEST}"
  local_executor_tmpfiles_installed=true
  mv -f -- "${self_update_recovery_service_stage}" "${SELF_UPDATE_RECOVERY_SERVICE_DEST}"
  self_update_recovery_service_installed=true
  mv -f -- "${self_update_recovery_timer_stage}" "${SELF_UPDATE_RECOVERY_TIMER_DEST}"
  self_update_recovery_timer_installed=true
fi

validate_identity_directory "${CONFIG_DIR}"
[[ $(stat -c '%d:%i' -- "${CONFIG_DIR}") == "${identity_config_dir_identity}" ]] || \
  die "Host Agent identity directory changed during installation"
if [[ ${install_mode} == "configured" ]]; then
  [[ $(stat -c '%U:%G:%a' -- "${CONFIG_DEST}") == "root:${AGENT_GROUP}:640" ]] || die "installed identity config failed verification"
  [[ $(sha256sum -- "${CONFIG_DEST}" | awk 'NR == 1 { print $1 }') == "${config_stage_sha256}" ]] || \
    die "installed identity content changed during atomic replacement"
  "${BINARY_DEST}" validate-config --config "${CONFIG_DEST}" || \
    die "installed identity failed secure reread validation"
fi
if [[ ${install_mode} == "prepare" || ${binary_managed_link} == true ]]; then
  validate_managed_agent_link || die "installed managed Host Agent binary failed verification"
else
  [[ $(stat -c '%U:%G:%a' -- "${BINARY_DEST}") == "root:root:755" ]] || \
    die "installed binary failed verification"
fi
[[ $(stat -c '%U:%G:%a' -- "${UNIT_DEST}") == "root:root:644" ]] || die "installed systemd unit failed verification"
if [[ ${install_mode} == "prepare" ]]; then
  recheck_private_root_directory \
    "${LOCAL_EXECUTOR_CONFIG_DIR}" \
    "${local_executor_config_dir_identity}"
  recheck_private_root_directory \
    "${LOCAL_EXECUTOR_DATA_DIR}" \
    "${local_executor_data_dir_identity}"
  recheck_private_root_directory \
    "${LOCAL_EXECUTOR_PORT_CONFIG_DIR}" \
    "${local_executor_port_config_dir_identity}"
  [[ -L ${LOCAL_EXECUTOR_BINARY_DEST} ]] || \
    die "prepared local executor binary is not linked to the atomic current runtime"
  [[ $(readlink -- "${LOCAL_EXECUTOR_BINARY_DEST}") == "${HOST_RUNTIME_CURRENT}/bin/autostream-local-executor" ]] || \
    die "prepared local executor binary link escaped the atomic current runtime"
  [[ $(readlink -f -- "${LOCAL_EXECUTOR_BINARY_DEST}") == "${HOST_RUNTIME_EXECUTOR}" ]] || \
    die "prepared local executor binary resolves outside the initial A/B slot"
  [[ $(stat -c '%U:%G:%a' -- "${HOST_RUNTIME_EXECUTOR}") == "root:root:755" ]] || \
    die "prepared local executor binary failed verification"
  [[ $(stat -c '%U:%G:%a' -- "${LOCAL_EXECUTOR_SERVICE_DEST}") == "root:root:644" ]] || \
    die "prepared local executor service failed verification"
  [[ $(stat -c '%U:%G:%a' -- "${LOCAL_EXECUTOR_SOCKET_DEST}") == "root:root:644" ]] || \
    die "prepared local executor socket failed verification"
  [[ $(stat -c '%U:%G:%a' -- "${LOCAL_EXECUTOR_TMPFILES_DEST}") == "root:root:644" ]] || \
    die "prepared local executor tmpfiles policy failed verification"
  [[ $(stat -c '%U:%G:%a' -- "${SELF_UPDATE_RECOVERY_SERVICE_DEST}") == "root:root:644" ]] || \
    die "prepared self-update recovery service template failed verification"
  [[ $(stat -c '%U:%G:%a' -- "${SELF_UPDATE_RECOVERY_TIMER_DEST}") == "root:root:644" ]] || \
    die "prepared self-update recovery timer template failed verification"
fi
if [[ ${install_mode} == "configured" ]]; then
  runuser -u "${AGENT_USER}" -- test -r "${CONFIG_DEST}" || die "agent service user cannot read installed identity config"
fi

systemctl daemon-reload
if [[ ${install_mode} == "configured" ]]; then
  if [[ ${legacy_config_existed} == true ]]; then
    # From this point onward the new identity and installed unit are the
    # recoverable state. Never roll them back after beginning destructive
    # retirement of the legacy secret.
    installation_complete=true
    retire_legacy_identity
  fi
  systemctl enable --now autostream-host-agent.service
  systemctl is-active --quiet "${UNIT_NAME}" || die "host agent did not become active"
else
  if systemctl is-active --quiet "${UNIT_NAME}" ||
    systemctl is-enabled --quiet "${UNIT_NAME}" ||
    systemctl is-active --quiet "${LOCAL_EXECUTOR_SERVICE_NAME}" ||
    systemctl is-active --quiet "${LOCAL_EXECUTOR_SOCKET_NAME}" ||
    systemctl is-enabled --quiet "${LOCAL_EXECUTOR_SERVICE_NAME}" ||
    systemctl is-enabled --quiet "${LOCAL_EXECUTOR_SOCKET_NAME}"; then
    die "--prepare must leave the Host Agent and local executor disabled and inactive"
  fi
  systemctl enable --now "${SELF_UPDATE_RECOVERY_TIMER_A}"
  self_update_recovery_timer_a_enabled=true
  systemctl enable --now "${SELF_UPDATE_RECOVERY_TIMER_B}"
  self_update_recovery_timer_b_enabled=true
  systemctl is-enabled --quiet "${SELF_UPDATE_RECOVERY_TIMER_A}" || \
    die "slot A self-update recovery timer was not enabled"
  systemctl is-enabled --quiet "${SELF_UPDATE_RECOVERY_TIMER_B}" || \
    die "slot B self-update recovery timer was not enabled"
  systemctl is-active --quiet "${SELF_UPDATE_RECOVERY_TIMER_A}" || \
    die "slot A self-update recovery timer did not become active"
  systemctl is-active --quiet "${SELF_UPDATE_RECOVERY_TIMER_B}" || \
    die "slot B self-update recovery timer did not become active"
  [[ ! -e ${CONFIG_DEST} && ! -L ${CONFIG_DEST} &&
    ! -e ${LEGACY_CONFIG_DEST} && ! -L ${LEGACY_CONFIG_DEST} ]] || \
    die "--prepare must not create an identity configuration"
  [[ ! -e ${LOCAL_EXECUTOR_POLICY_DEST} && ! -L ${LOCAL_EXECUTOR_POLICY_DEST} ]] || \
    die "--prepare must not create a local executor policy"
fi

installation_complete=true
if [[ ${install_mode} == "configured" ]]; then
  printf '%s\n' "AutoStream Host Agent installed in outbound pull mode; it opens no inbound listener."
else
  printf '%s\n' "AutoStream Host Agent and local executor runtime prepared but disabled; root A/B recovery timers are active. Run the Control Panel configure command before enabling either runtime unit."
fi
