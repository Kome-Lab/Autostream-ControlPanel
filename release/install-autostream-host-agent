#!/bin/bash
set -euo pipefail

umask 077
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C

readonly AGENT_USER="autostream-host-agent"
readonly AGENT_GROUP="autostream-host-agent"
readonly CONFIG_DIR="/etc/autostream-host-agent"
readonly CONFIG_DEST="${CONFIG_DIR}/identity.json"
readonly LEGACY_CONFIG_DEST="/etc/autostream/host-agent.json"
readonly BINARY_DEST="/usr/local/bin/autostream-host-agent"
readonly UNIT_DEST="/etc/systemd/system/autostream-host-agent.service"
readonly STATE_DIR="/var/lib/autostream-host-agent"
readonly UNIT_NAME="autostream-host-agent.service"
readonly LOCAL_EXECUTOR_CONFIG_DIR="/etc/autostream-local-executor"
readonly LOCAL_EXECUTOR_POLICY_DEST="${LOCAL_EXECUTOR_CONFIG_DIR}/policy.json"
readonly LOCAL_EXECUTOR_DATA_DIR="/opt/autostream/local-executor"
readonly LOCAL_EXECUTOR_PORT_CONFIG_DIR="${LOCAL_EXECUTOR_DATA_DIR}/ports"
readonly LOCAL_EXECUTOR_BINARY_DEST="/usr/local/libexec/autostream-local-executor"
readonly LOCAL_EXECUTOR_SERVICE_DEST="/etc/systemd/system/autostream-local-executor.service"
readonly LOCAL_EXECUTOR_SOCKET_DEST="/etc/systemd/system/autostream-local-executor.socket"
readonly LOCAL_EXECUTOR_TMPFILES_DEST="/etc/tmpfiles.d/autostream-local-executor.conf"
readonly SELF_UPDATE_RECOVERY_SERVICE_DEST="/etc/systemd/system/autostream-host-self-update-recovery@.service"
readonly SELF_UPDATE_RECOVERY_TIMER_DEST="/etc/systemd/system/autostream-host-self-update-recovery@.timer"
readonly LOCAL_EXECUTOR_SERVICE_NAME="autostream-local-executor.service"
readonly LOCAL_EXECUTOR_SOCKET_NAME="autostream-local-executor.socket"
readonly SELF_UPDATE_RECOVERY_TIMER_A="autostream-host-self-update-recovery@a.timer"
readonly SELF_UPDATE_RECOVERY_TIMER_B="autostream-host-self-update-recovery@b.timer"
readonly SELF_UPDATE_RECOVERY_SERVICE_A="autostream-host-self-update-recovery@a.service"
readonly SELF_UPDATE_RECOVERY_SERVICE_B="autostream-host-self-update-recovery@b.service"
readonly HOST_RUNTIME_ROOT="/opt/autostream/host-agent"
readonly HOST_RUNTIME_SLOTS="${HOST_RUNTIME_ROOT}/slots"
readonly HOST_RUNTIME_INITIAL_SLOT="${HOST_RUNTIME_SLOTS}/a"
readonly HOST_RUNTIME_CURRENT="${HOST_RUNTIME_ROOT}/current"
readonly HOST_RUNTIME_AGENT="${HOST_RUNTIME_INITIAL_SLOT}/bin/autostream-host-agent"
readonly HOST_RUNTIME_EXECUTOR="${HOST_RUNTIME_INITIAL_SLOT}/bin/autostream-local-executor"

usage() {
  cat >&2 <<'EOF'
Usage:
  install-autostream-host-agent --prepare
  install-autostream-host-agent --config PATH

--prepare installs the service account, Host Agent, and the same-release local
executor binary and units. It also prepares the root:root 0700 policy and port
configuration directories, but does not create either identity/policy, enable
the runtime units, or start either runtime service. It enables only the
root-owned A/B recovery timers. Complete the generated Control Panel configure
command before explicitly enabling the Host Agent and executor socket.

--config preserves the legacy one-step installation. PATH must be a regular
JSON file containing exactly panel_url, node_id, runtime_token, and
service_name. The token is copied from that file and is never accepted through
an argument or environment variable.
EOF
}

die() {
  printf 'install-autostream-host-agent: %s\n' "$*" >&2
  exit 1
}

[[ ${EUID} -eq 0 ]] || die "must run as root"

install_mode=""
config_source=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --prepare)
      [[ -z ${install_mode} ]] || die "--prepare and --config are mutually exclusive"
      install_mode="prepare"
      shift
      ;;
    --config)
      [[ $# -ge 2 && -n $2 ]] || die "--config requires a path"
      [[ -z ${install_mode} ]] || die "--prepare and --config are mutually exclusive"
      install_mode="configured"
      config_source=$2
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage
      die "unknown argument: $1"
      ;;
  esac
done
[[ -n ${install_mode} ]] || {
  usage
  die "--prepare or --config PATH is required"
}
for command in awk dd dirname getent groupadd id install ln mktemp mv readlink rm rmdir runuser sha256sum sort stat sync systemctl test tr useradd; do
  command -v "${command}" >/dev/null 2>&1 || die "required command is unavailable: ${command}"
done
if [[ ${install_mode} == "configured" ]]; then
  [[ ${config_source} = /* ]] || die "--config must be an absolute path"
fi

readonly SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
readonly RELEASE_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd -P)"
readonly BINARY_SOURCE="${RELEASE_ROOT}/bin/autostream-host-agent"
readonly UNIT_SOURCE="${RELEASE_ROOT}/systemd/autostream-host-agent.service"
readonly LOCAL_EXECUTOR_POLICY_TEMPLATE="${RELEASE_ROOT}/autostream-local-executor-policy.json.example"
readonly LOCAL_EXECUTOR_BINARY_SOURCE="${RELEASE_ROOT}/bin/autostream-local-executor"
readonly LOCAL_EXECUTOR_SERVICE_SOURCE="${RELEASE_ROOT}/systemd/autostream-local-executor.service"
readonly LOCAL_EXECUTOR_SOCKET_SOURCE="${RELEASE_ROOT}/systemd/autostream-local-executor.socket"
readonly LOCAL_EXECUTOR_TMPFILES_SOURCE="${RELEASE_ROOT}/systemd/autostream-local-executor.tmpfiles"
readonly SELF_UPDATE_RECOVERY_SERVICE_SOURCE="${RELEASE_ROOT}/systemd/autostream-host-self-update-recovery@.service"
readonly SELF_UPDATE_RECOVERY_TIMER_SOURCE="${RELEASE_ROOT}/systemd/autostream-host-self-update-recovery@.timer"

[[ -f ${BINARY_SOURCE} && ! -L ${BINARY_SOURCE} ]] || die "verified host agent binary is missing"
[[ -f ${UNIT_SOURCE} && ! -L ${UNIT_SOURCE} ]] || die "packaged systemd unit is missing"
if [[ ${install_mode} == "prepare" ]]; then
  for source in \
    "${LOCAL_EXECUTOR_POLICY_TEMPLATE}" \
    "${LOCAL_EXECUTOR_BINARY_SOURCE}" \
    "${LOCAL_EXECUTOR_SERVICE_SOURCE}" \
    "${LOCAL_EXECUTOR_SOCKET_SOURCE}" \
    "${LOCAL_EXECUTOR_TMPFILES_SOURCE}" \
    "${SELF_UPDATE_RECOVERY_SERVICE_SOURCE}" \
    "${SELF_UPDATE_RECOVERY_TIMER_SOURCE}"; do
    [[ -f ${source} && ! -L ${source} ]] || \
      die "same-release local executor preparation asset is missing or unsafe: ${source}"
  done
fi

validate_root_parent_chain() {
  local path=$1
  local label=$2
  local current
  local parent
  local mode
  current=$(dirname -- "${path}")
  while true; do
    [[ -d ${current} && ! -L ${current} ]] || die "${label} parents must be non-symlink directories"
    [[ $(stat -c '%U:%G' -- "${current}") == "root:root" ]] || \
      die "${label} parents must be owned by root:root"
    mode=$(stat -c '%a' -- "${current}")
    (( (8#${mode} & 0022) == 0 )) || \
      die "${label} parents must not be writable by group or other"
    parent=$(dirname -- "${current}")
    [[ ${parent} == "${current}" ]] && break
    current=${parent}
  done
}

validate_root_owned_release_source() {
  local source=$1
  local mode
  [[ -f ${source} && ! -L ${source} ]] || die "release asset ${source} is missing or unsafe"
  [[ $(stat -c '%U:%G' -- "${source}") == "root:root" ]] || \
    die "release asset ${source} must be owned by root:root"
  mode=$(stat -c '%a' -- "${source}")
  (( (8#${mode} & 0022) == 0 )) || \
    die "release asset ${source} must not be writable by group or other"
  validate_root_parent_chain "${source}" "release source"
}

validate_root_owned_config_source() {
  local source=$1
  [[ -f ${source} && ! -L ${source} ]] || \
    die "config source must be a regular non-symlink file"
  [[ $(stat -c '%U:%G:%a' -- "${source}") == "root:root:600" ]] || \
    die "config source must be root:root 0600"
  [[ $(stat -c %s -- "${source}") -gt 0 && $(stat -c %s -- "${source}") -le 1048576 ]] || \
    die "config source must be between 1 byte and 1 MiB"
  validate_root_parent_chain "${source}" "config source"
}

validate_root_owned_release_source "${BINARY_SOURCE}"
validate_root_owned_release_source "${UNIT_SOURCE}"
if [[ ${install_mode} == "prepare" ]]; then
  validate_root_owned_release_source "${LOCAL_EXECUTOR_POLICY_TEMPLATE}"
  validate_root_owned_release_source "${LOCAL_EXECUTOR_BINARY_SOURCE}"
  validate_root_owned_release_source "${LOCAL_EXECUTOR_SERVICE_SOURCE}"
  validate_root_owned_release_source "${LOCAL_EXECUTOR_SOCKET_SOURCE}"
  validate_root_owned_release_source "${LOCAL_EXECUTOR_TMPFILES_SOURCE}"
  validate_root_owned_release_source "${SELF_UPDATE_RECOVERY_SERVICE_SOURCE}"
  validate_root_owned_release_source "${SELF_UPDATE_RECOVERY_TIMER_SOURCE}"
fi
if [[ ${install_mode} == "configured" ]]; then
  validate_root_owned_config_source "${config_source}"
fi

copy_verified_release_file() {
  local source=$1
  local destination=$2
  local owner=$3
  local group=$4
  local mode=$5
  local label=$6
  local source_identity
  local source_sha256
  [[ -f ${source} && ! -L ${source} ]] || die "${label} release source is missing or unsafe"
  source_identity=$(stat -c '%d:%i:%s:%Y:%f' -- "${source}")
  source_sha256=$(sha256sum -- "${source}" | awk 'NR == 1 { print $1 }')
  install -o "${owner}" -g "${group}" -m "${mode}" "${source}" "${destination}"
  [[ -f ${source} && ! -L ${source} ]] || die "${label} release source changed while it was copied"
  [[ $(stat -c '%d:%i:%s:%Y:%f' -- "${source}") == "${source_identity}" ]] || \
    die "${label} release source identity changed while it was copied"
  [[ $(sha256sum -- "${source}" | awk 'NR == 1 { print $1 }') == "${source_sha256}" ]] || \
    die "${label} release source content changed while it was copied"
  [[ $(sha256sum -- "${destination}" | awk 'NR == 1 { print $1 }') == "${source_sha256}" ]] || \
    die "staged ${label} does not match the verified release source"
}

copy_verified_config_file() {
  local source=$1
  local destination=$2
  local source_identity
  local source_sha256
  validate_root_owned_config_source "${source}"
  source_identity=$(stat -c '%d:%i:%s:%Y:%f:%u:%g' -- "${source}")
  source_sha256=$(sha256sum -- "${source}" | awk 'NR == 1 { print $1 }')
  install -o root -g "${AGENT_GROUP}" -m 0640 "${source}" "${destination}"
  validate_root_owned_config_source "${source}"
  [[ $(stat -c '%d:%i:%s:%Y:%f:%u:%g' -- "${source}") == "${source_identity}" ]] || \
    die "config source identity changed while it was copied"
  [[ $(sha256sum -- "${source}" | awk 'NR == 1 { print $1 }') == "${source_sha256}" ]] || \
    die "config source content changed while it was copied"
  [[ $(sha256sum -- "${destination}" | awk 'NR == 1 { print $1 }') == "${source_sha256}" ]] || \
    die "staged identity does not match the verified config source"
}

if [[ ${install_mode} == "prepare" ]]; then
  [[ ! -e ${CONFIG_DEST} && ! -L ${CONFIG_DEST} &&
    ! -e ${LEGACY_CONFIG_DEST} && ! -L ${LEGACY_CONFIG_DEST} ]] || \
    die "--prepare refuses an existing identity; use --config PATH for a configured installation"
  [[ ! -e ${LOCAL_EXECUTOR_POLICY_DEST} && ! -L ${LOCAL_EXECUTOR_POLICY_DEST} ]] || \
    die "--prepare refuses an existing local executor policy; use the local executor installer for upgrades"
  if systemctl is-active --quiet "${UNIT_NAME}"; then
    die "--prepare requires the Host Agent service to be inactive"
  fi
  if systemctl is-enabled --quiet "${UNIT_NAME}"; then
    die "--prepare requires the Host Agent service to be disabled"
  fi
  if systemctl is-active --quiet "${LOCAL_EXECUTOR_SERVICE_NAME}" ||
    systemctl is-active --quiet "${LOCAL_EXECUTOR_SOCKET_NAME}" ||
    systemctl is-active --quiet "${SELF_UPDATE_RECOVERY_SERVICE_A}" ||
    systemctl is-active --quiet "${SELF_UPDATE_RECOVERY_SERVICE_B}" ||
    systemctl is-active --quiet "${SELF_UPDATE_RECOVERY_TIMER_A}" ||
    systemctl is-active --quiet "${SELF_UPDATE_RECOVERY_TIMER_B}"; then
    die "--prepare requires the local executor and self-update recovery timers to be inactive"
  fi
  if systemctl is-enabled --quiet "${LOCAL_EXECUTOR_SERVICE_NAME}" ||
    systemctl is-enabled --quiet "${LOCAL_EXECUTOR_SOCKET_NAME}" ||
    systemctl is-enabled --quiet "${SELF_UPDATE_RECOVERY_TIMER_A}" ||
    systemctl is-enabled --quiet "${SELF_UPDATE_RECOVERY_TIMER_B}"; then
    die "--prepare requires the local executor and self-update recovery timers to be disabled"
  fi
  [[ ! -e ${HOST_RUNTIME_ROOT} && ! -L ${HOST_RUNTIME_ROOT} ]] || \
    die "--prepare refuses an existing Host Agent A/B runtime root"
fi

if ! getent group "${AGENT_GROUP}" >/dev/null; then
  groupadd --system "${AGENT_GROUP}"
fi
if ! id "${AGENT_USER}" >/dev/null 2>&1; then
  useradd \
    --system \
    --gid "${AGENT_GROUP}" \
    --home-dir "${STATE_DIR}" \
    --shell /usr/sbin/nologin \
    "${AGENT_USER}"
fi
[[ $(id -u "${AGENT_USER}") -ne 0 ]] || die "agent user must not be root"
[[ $(id -gn "${AGENT_USER}") == "${AGENT_GROUP}" ]] || die "agent user must use the dedicated primary group"
mapfile -t supplementary_groups < <(id -Gn "${AGENT_USER}" | tr ' ' '\n' | LC_ALL=C sort -u)
[[ ${#supplementary_groups[@]} -eq 1 && ${supplementary_groups[0]} == "${AGENT_GROUP}" ]] || \
  die "agent user must not belong to supplementary groups"
IFS=: read -r _ _ agent_gid agent_group_members < <(getent group "${AGENT_GROUP}")
[[ ${agent_gid} =~ ^[0-9]+$ ]] || die "agent group has an invalid gid"
if [[ -n ${agent_group_members} ]]; then
  IFS=, read -r -a explicit_group_members <<<"${agent_group_members}"
  for member in "${explicit_group_members[@]}"; do
    [[ ${member} == "${AGENT_USER}" ]] || die "agent group must not grant identity access to another user"
  done
fi
while IFS=: read -r account_name _ _ account_gid _ _ _; do
  if [[ ${account_gid} == "${agent_gid}" && ${account_name} != "${AGENT_USER}" ]]; then
    die "agent group must not be the primary group of another user"
  fi
done < <(getent passwd)
IFS=: read -r _ _ _ _ _ agent_home agent_shell < <(getent passwd "${AGENT_USER}")
[[ ${agent_home} == "${STATE_DIR}" ]] || die "agent user must use ${STATE_DIR} as its home"
[[ ${agent_shell} == "/usr/sbin/nologin" ]] || die "agent user must use /usr/sbin/nologin"

ensure_root_directory() {
  local path=$1
  local create_mode=$2
  local mode
  if [[ -e ${path} || -L ${path} ]]; then
    [[ -d ${path} && ! -L ${path} ]] || die "${path} must be a non-symlink directory"
    [[ $(stat -c '%U:%G' -- "${path}") == "root:root" ]] || die "${path} must be owned by root:root"
    mode=$(stat -c '%a' -- "${path}")
    (( (8#${mode} & 0022) == 0 )) || die "${path} must not be writable by group or other"
    return
  fi
  install -d -o root -g root -m "${create_mode}" "${path}"
}

validate_private_root_directory() {
  local path=$1
  [[ -d ${path} && ! -L ${path} ]] || die "${path} must be a non-symlink directory"
  [[ $(stat -c '%U:%G:%a' -- "${path}") == "root:root:700" ]] || \
    die "${path} must be root:root 0700"
}

recheck_private_root_directory() {
  local path=$1
  local expected_identity=$2
  validate_private_root_directory "${path}"
  [[ $(stat -c '%d:%i' -- "${path}") == "${expected_identity}" ]] || \
    die "${path} changed after preflight"
}

create_private_root_directory() {
  local path=$1
  local created_variable=$2
  local identity_variable=$3
  local identity=""
  [[ ! -e ${path} && ! -L ${path} ]] || \
    die "${path} appeared after preflight"
  printf -v "${created_variable}" '%s' true
  if ! install -d -o root -g root -m 0700 "${path}"; then
    if [[ -d ${path} && ! -L ${path} ]]; then
      identity=$(stat -c '%d:%i' -- "${path}" 2>/dev/null || true)
      printf -v "${identity_variable}" '%s' "${identity}"
    fi
    die "could not create ${path}"
  fi
  identity=$(stat -c '%d:%i' -- "${path}")
  printf -v "${identity_variable}" '%s' "${identity}"
  validate_private_root_directory "${path}"
}

validate_identity_directory() {
  local path=$1
  [[ -d ${path} && ! -L ${path} ]] || \
    die "${path} must be a non-symlink directory"
  [[ $(stat -c '%U:%G:%a' -- "${path}") == "root:${AGENT_GROUP}:750" ]] || \
    die "${path} must be root:${AGENT_GROUP} 0750"
}

ensure_root_directory /etc/autostream 0755
ensure_root_directory /usr/local/bin 0755
ensure_root_directory /etc/systemd/system 0755
identity_config_dir_created=false
identity_config_dir_identity=""
if [[ -e ${CONFIG_DIR} || -L ${CONFIG_DIR} ]]; then
  validate_identity_directory "${CONFIG_DIR}"
  identity_config_dir_identity=$(stat -c '%d:%i' -- "${CONFIG_DIR}")
else
  install -d -o root -g "${AGENT_GROUP}" -m 0750 "${CONFIG_DIR}"
  identity_config_dir_created=true
  identity_config_dir_identity=$(stat -c '%d:%i' -- "${CONFIG_DIR}")
  validate_identity_directory "${CONFIG_DIR}"
fi
local_executor_config_dir_existed=false
local_executor_data_dir_existed=false
local_executor_port_config_dir_existed=false
local_executor_config_dir_identity=""
local_executor_data_dir_identity=""
local_executor_port_config_dir_identity=""
if [[ ${install_mode} == "prepare" ]]; then
  ensure_root_directory /usr/local/libexec 0755
  ensure_root_directory /etc/tmpfiles.d 0755
  ensure_root_directory /opt/autostream 0755
  if [[ -e ${LOCAL_EXECUTOR_CONFIG_DIR} || -L ${LOCAL_EXECUTOR_CONFIG_DIR} ]]; then
    validate_private_root_directory "${LOCAL_EXECUTOR_CONFIG_DIR}"
    local_executor_config_dir_existed=true
    local_executor_config_dir_identity=$(stat -c '%d:%i' -- "${LOCAL_EXECUTOR_CONFIG_DIR}")
  fi
  if [[ -e ${LOCAL_EXECUTOR_DATA_DIR} || -L ${LOCAL_EXECUTOR_DATA_DIR} ]]; then
    validate_private_root_directory "${LOCAL_EXECUTOR_DATA_DIR}"
    local_executor_data_dir_existed=true
    local_executor_data_dir_identity=$(stat -c '%d:%i' -- "${LOCAL_EXECUTOR_DATA_DIR}")
  fi
  if [[ -e ${LOCAL_EXECUTOR_PORT_CONFIG_DIR} || -L ${LOCAL_EXECUTOR_PORT_CONFIG_DIR} ]]; then
    validate_private_root_directory "${LOCAL_EXECUTOR_PORT_CONFIG_DIR}"
    local_executor_port_config_dir_existed=true
    local_executor_port_config_dir_identity=$(stat -c '%d:%i' -- "${LOCAL_EXECUTOR_PORT_CONFIG_DIR}")
  fi
fi
if [[ -e ${STATE_DIR} || -L ${STATE_DIR} ]]; then
  [[ -d ${STATE_DIR} && ! -L ${STATE_DIR} ]] || die "${STATE_DIR} must be a non-symlink directory"
  [[ $(stat -c '%U:%G:%a' -- "${STATE_DIR}") == "${AGENT_USER}:${AGENT_GROUP}:700" ]] || \
    die "${STATE_DIR} must be ${AGENT_USER}:${AGENT_GROUP} 0700"
else
  install -d -o "${AGENT_USER}" -g "${AGENT_GROUP}" -m 0700 "${STATE_DIR}"
fi

config_stage=""
config_stage_sha256=""
if [[ ${install_mode} == "configured" ]]; then
  config_stage=$(mktemp "${CONFIG_DIR}/.identity.json.new.XXXXXX")
fi
binary_stage=$(mktemp /usr/local/bin/.autostream-host-agent.new.XXXXXX)
unit_stage=$(mktemp /etc/systemd/system/.autostream-host-agent.service.new.XXXXXX)
local_executor_binary_stage=""
local_executor_service_stage=""
local_executor_socket_stage=""
local_executor_tmpfiles_stage=""
self_update_recovery_service_stage=""
self_update_recovery_timer_stage=""
if [[ ${install_mode} == "prepare" ]]; then
  local_executor_binary_stage=$(mktemp /usr/local/libexec/.autostream-local-executor.new.XXXXXX)
  local_executor_service_stage=$(mktemp /etc/systemd/system/.autostream-local-executor.service.new.XXXXXX)
  local_executor_socket_stage=$(mktemp /etc/systemd/system/.autostream-local-executor.socket.new.XXXXXX)
  local_executor_tmpfiles_stage=$(mktemp /etc/tmpfiles.d/.autostream-local-executor.conf.new.XXXXXX)
  self_update_recovery_service_stage=$(mktemp /etc/systemd/system/.autostream-host-self-update-recovery.service.new.XXXXXX)
  self_update_recovery_timer_stage=$(mktemp /etc/systemd/system/.autostream-host-self-update-recovery.timer.new.XXXXXX)
fi
config_backup=""
binary_backup=""
unit_backup=""
local_executor_binary_backup=""
local_executor_service_backup=""
local_executor_socket_backup=""
local_executor_tmpfiles_backup=""
self_update_recovery_service_backup=""
self_update_recovery_timer_backup=""
commit_started=false
installation_complete=false
was_active=false
was_enabled=false
service_quiesced=false
config_existed=false
config_identity=""
config_sha256=""
legacy_config_existed=false
legacy_config_identity=""
legacy_config_sha256=""
legacy_config_retired=false
binary_existed=false
unit_existed=false
local_executor_binary_existed=false
local_executor_service_existed=false
local_executor_socket_existed=false
local_executor_tmpfiles_existed=false
self_update_recovery_service_existed=false
self_update_recovery_timer_existed=false
config_backed_up=false
binary_backed_up=false
unit_backed_up=false
local_executor_binary_backed_up=false
local_executor_service_backed_up=false
local_executor_socket_backed_up=false
local_executor_tmpfiles_backed_up=false
self_update_recovery_service_backed_up=false
self_update_recovery_timer_backed_up=false
config_installed=false
binary_installed=false
unit_installed=false
local_executor_binary_installed=false
local_executor_service_installed=false
local_executor_socket_installed=false
local_executor_tmpfiles_installed=false
