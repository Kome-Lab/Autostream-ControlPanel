+func TestUI188CB16AdapterConflictBudgetAndDeadline(t *testing.T) {
+	err := control.ControlPanelError{StatusCode: 500, Code: ui188CB16AssignmentConflictCode}
+	p := newUI188CB16RefreshPolicy(30 * time.Second)
+	now := time.Now()
+	if p.window != 93*time.Second {
+		t.Fatal("budget contradicts normal HTTP timeout/period")
+	}
+	for tick := 1; tick <= 3; tick++ {
+		p.Observe(control.RuntimeConfig{}, err, now.Add(time.Duration(tick)*time.Second))
+		if p.CanAwait() != (tick < 3) {
+			t.Fatal("conflict tick budget not finite")
+		}
+	}
+	p.Observe(cb15BoundConfig(t), nil, now.Add(4*time.Second))
+	if !p.Failed() || p.MatchesExpected(cb15BoundConfig(t)) {
+		t.Fatal("failed budget reset by later success")
+	}
+	p = newUI188CB16RefreshPolicy(30 * time.Second)
+	p.Observe(control.RuntimeConfig{}, err, now)
+	p.Observe(cb15BoundConfig(t), nil, now.Add(94*time.Second))
+	if !p.Failed() {
+		t.Fatal("late response exceeded original convergence deadline")
+	}
+	p = newUI188CB16RefreshPolicy(30 * time.Second)
+	p.Observe(control.RuntimeConfig{}, context.Canceled, now)
+	if !p.Failed() {
+		t.Fatal("cancel treated as recoverable conflict")
+	}
+}
