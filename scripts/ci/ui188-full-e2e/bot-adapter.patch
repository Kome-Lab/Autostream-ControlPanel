+func TestUI188CB16AdapterAuthorityFailuresMatchProductPolicy(t *testing.T) {
+	for _, tc := range []struct {
+		name   string
+		status int
+		body   string
+		clears bool
+	}{
+		{"401", 401, `{"code":"service_token_invalid"}`, true},
+		{"unknown403", 403, `{"code":"unknown_forbidden"}`, true},
+		{"malformed current", 200, `{"current_discord_bindings":{"version":"invalid"}}`, true},
+		{"general500", 500, `{"code":"get_service_failed"}`, false},
+		{"old unclassified500", 500, `{"code":"current_discord_binding_unavailable"}`, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			cfg := cb15BoundConfig(t)
+			var gets, mutations atomic.Int32
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if r.Method == http.MethodPost && r.URL.Path == "/services/runtime-secrets/resolve" {
+					_ = json.NewEncoder(w).Encode(map[string]any{"value": "test-only-current-credential"})
+					return
+				}
+				if r.Method != http.MethodGet {
+					mutations.Add(1)
+					w.WriteHeader(403)
+					return
+				}
+				if gets.Add(1) == 1 {
+					_ = json.NewEncoder(w).Encode(cfg)
+					return
+				}
+				w.WriteHeader(tc.status)
+				_, _ = w.Write([]byte(tc.body))
+			}))
+			defer server.Close()
+			client := control.Client{Config: control.Config{ControlPanelURL: server.URL, Token: "test-only", ServiceID: "own", ServiceName: "own", ServicePublicURL: "https://bot.example.com"}, HTTP: &http.Client{Timeout: 30 * time.Second}}
+			voice := &cb15ObservedGateway{}
+			manager := jobs.NewManager(voice)
+			if _, err := ui188CB16RefreshOnce(t.Context(), client, manager, nil); err != nil {
+				t.Fatal("initial client fixture")
+			}
+			got, err := ui188CB16RefreshOnce(t.Context(), client, manager, nil)
+			policy := newUI188CB16RefreshPolicy(client.HTTP.Timeout)
+			policy.Observe(got, err, time.Now())
+			if err == nil || policy.CanAwait() || !policy.Failed() || gets.Load() != 2 || mutations.Load() != 0 {
+				t.Fatal("unknown/auth failure was retried or accepted")
+			}
+			if tc.clears && (voice.selected || voice.token != "") {
+				t.Fatal("authority failure did not apply product eligibility invalidation")
+			}
+		})
+	}
+}
