+func TestUI188CB16AdapterConflictConvergesOnlyToCurrent(t *testing.T) {
+	a := cb15BoundConfig(t)
+	b := cb15Clone(t, a)
+	b.Service.CurrentStreamID = "s2"
+	b.Assignments[0].StreamID = "s2"
+	b.Assignments[0].AssignedAt = b.Assignments[0].AssignedAt.Add(time.Second)
+	b.CurrentDiscordBindings.Bindings[0].StreamID = "s2"
+	b.CurrentDiscordBindings.Bindings[0].AssignmentEpoch = b.Assignments[0].AssignedAt
+	b.StreamDiscordConfigs[0].StreamID = "s2"
+	var gets, resolves, mutations atomic.Int32
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method == http.MethodPost && r.URL.Path == "/services/runtime-secrets/resolve" {
+			resolves.Add(1)
+			_ = json.NewEncoder(w).Encode(map[string]any{"value": "test-only-current-credential"})
+			return
+		}
+		if r.Method != http.MethodGet {
+			mutations.Add(1)
+			w.WriteHeader(403)
+			return
+		}
