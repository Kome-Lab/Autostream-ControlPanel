+	if err = step(); err != nil || policy.CanAwait() || !policy.MatchesExpected(b) || policy.MatchesExpected(a) || gets.Load() != 3 || mutations.Load() != 0 {
+		t.Fatal("next regular read did not converge to current B without mutation replay")
+	}
+	stale := cb15Clone(t, b)
+	stale.CurrentDiscordBindings.Bindings[0].AssignmentEpoch = stale.CurrentDiscordBindings.Bindings[0].AssignmentEpoch.Add(-time.Second)
