@@ -0,0 +1,318 @@
+//go:build linux && ui188_chain
+
+package main
+
+// This file is part of the separate Actions test adapter, never the product BOT.
+import (
+	"bytes"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+)
+
+type ui188ActionsRun struct {
+	SchemaVersion int               `json:"schema_version"`
+	Scope         string            `json:"scope"`
+	UUID          string            `json:"run_uuid"`
+	Case          string            `json:"case"`
+	Schema        string            `json:"schema"`
+	Services      map[string]string `json:"services"`
+	LockSHA       string            `json:"source_lock_sha256"`
+	RunID         int64             `json:"github_run_id"`
+	Attempt       int               `json:"github_run_attempt"`
+	Job           string            `json:"job"`
+	StartedNS     int64             `json:"started_ns,string"`
+	Sources       map[string]string `json:"source_shas"`
+}
+
+// encoding/json otherwise silently accepts duplicate keys. Check every object.
+func ui188ActionsUniqueJSON(raw []byte) bool {
+	d := json.NewDecoder(bytes.NewReader(raw))
+	var value func(int) bool
+	value = func(depth int) bool {
+		if depth > 4 {
+			return false
+		}
+		token, err := d.Token()
+		if err != nil {
+			return false
+		}
+		delim, nested := token.(json.Delim)
+		if !nested {
+			return true
+		}
+		if delim != '{' {
+			return false
+		}
+		seen := map[string]bool{}
+		for d.More() {
+			key, err := d.Token()
+			name, valid := key.(string)
+			if err != nil || !valid || seen[name] {
+				return false
+			}
+			seen[name] = true
+			if !value(depth + 1) {
+				return false
+			}
+		}
+		last, err := d.Token()
+		return err == nil && last == json.Delim('}')
+	}
+	if !value(0) {
+		return false
+	}
+	_, err := d.Token()
+	return err == io.EOF
+}
+
+func ui188ActionsManifest(root, caseID, schema, runUUID string) (ui188ActionsRun, bool) {
+	var result ui188ActionsRun
+	path := filepath.Join(root, "identity.json")
+	if !filepath.IsAbs(root) || filepath.Clean(os.Getenv("UI188_RUN_IDENTITY")) != path {
+		return result, false
+	}
+	info, err := os.Lstat(path)
+	if err != nil || !info.Mode().IsRegular() || info.Mode()&os.ModeSymlink != 0 || info.Size() > 16384 {
+		return result, false
+	}
+	raw, err := os.ReadFile(path)
+	if err != nil || !ui188ActionsUniqueJSON(raw) {
+		return result, false
+	}
+	digest := sha256.Sum256(raw)
+	if hex.EncodeToString(digest[:]) != os.Getenv("UI188_IDENTITY_SHA256") {
+		return result, false
+	}
+	var fields map[string]json.RawMessage
+	names := []string{"schema_version", "scope", "run_uuid", "case", "schema", "services", "source_lock_sha256", "github_run_id", "github_run_attempt", "job", "started_ns", "source_shas"}
+	if json.Unmarshal(raw, &fields) != nil || len(fields) != len(names) {
+		return result, false
+	}
+	for _, name := range names {
+		if _, present := fields[name]; !present {
+			return result, false
+		}
+	}
+	d := json.NewDecoder(bytes.NewReader(raw))
+	d.DisallowUnknownFields()
+	if d.Decode(&result) != nil || d.Decode(new(any)) != io.EOF {
+		return result, false
+	}
+	uuidRE := regexp.MustCompile(`^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$`)
+	hexID := strings.ReplaceAll(result.UUID, "-", "")
+	if !uuidRE.MatchString(result.UUID) || result.UUID != runUUID || result.SchemaVersion != 2 || result.Scope != "UI188_ACTIONS_RUN" ||
+		result.Case != caseID || result.Case != "gha-"+hexID[:16] || result.Schema != schema || result.Schema != "ui188_gha_"+hexID ||
+		result.Attempt != 1 || result.RunID < 1 || result.RunID > 9007199254740991 || (result.Job != "full-e2e" && result.Job != "contract-smoke") || result.StartedNS < 1000000000000000000 || result.StartedNS > time.Now().UnixNano() {
+		return result, false
+	}
+	for key, expected := range map[string]string{
+		"UI188_RUN_UUID": result.UUID, "UI188_WAIT_CALLER_RUN_ID": result.UUID,
+		"UI188_PROBE_ATTEMPT": result.Case, "UI188_DB_SCHEMA": result.Schema,
+		"UI188_GITHUB_RUN_ID": strconv.FormatInt(result.RunID, 10), "UI188_GITHUB_RUN_ATTEMPT": "1",
+		"UI188_SOURCE_LOCK_SHA256": result.LockSHA,
+		"UI188_IDENTITY_JOB":       result.Job,
+	} {
+		if os.Getenv(key) != expected {
+			return result, false
+		}
+	}
+	if !regexp.MustCompile(`^[0-9a-f]{64}$`).MatchString(result.LockSHA) || len(result.Sources) != 4 || len(result.Services) != 6 {
+		return result, false
+	}
+	for _, key := range []string{"cp", "bot", "encoder", "worker"} {
+		if !regexp.MustCompile(`^[0-9a-f]{40}$`).MatchString(result.Sources[key]) {
+			return result, false
+		}
+	}
+	for _, key := range []string{"bot-a", "bot-b", "encoder-a", "encoder-b", "worker-a", "worker-b"} {
+		if result.Services[key] != key {
+			return result, false
+		}
+	}
+	return result, true
+}
+
+func ui188ActionsService(root, caseID, schema, runUUID, service string) bool {
+	manifest, valid := ui188ActionsManifest(root, caseID, schema, runUUID)
+	return valid && (service == manifest.Services["bot-a"] || service == manifest.Services["bot-b"])
+}
+
+// Unit policy fixtures are fresh for each invocation. The cross-language proof
+// below still requires the actual Python producer's manifest and environment.
+func ui188ActionsUnitContext(t *testing.T) (string, ui188ActionsRun, []byte) {
+	t.Helper()
+	id := make([]byte, 16)
+	if _, err := rand.Read(id); err != nil {
+		t.Fatal(err)
+	}
+	id[6] = (id[6] & 15) | 64
+	id[8] = (id[8] & 63) | 128
+	uuid := fmt.Sprintf("%x-%x-%x-%x-%x", id[:4], id[4:6], id[6:8], id[8:10], id[10:])
+	hexID := strings.ReplaceAll(uuid, "-", "")
+	run := ui188ActionsRun{SchemaVersion: 2, Scope: "UI188_ACTIONS_RUN", UUID: uuid,
+		Case: "gha-" + hexID[:16], Schema: "ui188_gha_" + hexID, LockSHA: strings.Repeat("a", 64),
+		RunID: 42, Attempt: 1, Job: "contract-smoke", StartedNS: time.Now().UnixNano(),
+		Services: map[string]string{}, Sources: map[string]string{}}
+	for _, key := range []string{"bot-a", "bot-b", "encoder-a", "encoder-b", "worker-a", "worker-b"} {
+		run.Services[key] = key
+	}
+	for _, key := range []string{"cp", "bot", "encoder", "worker"} {
+		run.Sources[key] = strings.Repeat("b", 40)
+	}
+	raw, err := json.Marshal(run)
+	if err != nil {
+		t.Fatal(err)
+	}
+	raw = append(raw, '\n')
+	root := t.TempDir()
+	path := filepath.Join(root, "identity.json")
+	if err := os.WriteFile(path, raw, 0600); err != nil {
+		t.Fatal(err)
+	}
+	digest := sha256.Sum256(raw)
+	for key, value := range map[string]string{"UI188_EVIDENCE_DIRECTORY": root, "UI188_RUN_IDENTITY": path,
+		"UI188_IDENTITY_SHA256": hex.EncodeToString(digest[:]), "UI188_RUN_UUID": uuid,
+		"UI188_WAIT_CALLER_RUN_ID": uuid, "UI188_PROBE_ATTEMPT": run.Case, "UI188_DB_SCHEMA": run.Schema,
+		"UI188_GITHUB_RUN_ID": "42", "UI188_GITHUB_RUN_ATTEMPT": "1", "UI188_SOURCE_LOCK_SHA256": run.LockSHA,
+		"UI188_IDENTITY_JOB": run.Job} {
+		t.Setenv(key, value)
+	}
+	return root, run, raw
+}
+
+func TestUI188ActionsActualConstructor(t *testing.T) {
+	root := os.Getenv("UI188_EVIDENCE_DIRECTORY")
+	caseID, schema, run := os.Getenv("UI188_PROBE_ATTEMPT"), os.Getenv("UI188_DB_SCHEMA"), os.Getenv("UI188_RUN_UUID")
+	if _, valid := ui188ActionsManifest(root, caseID, schema, run); !valid {
+		t.Fatal("Python-produced manifest/environment rejected by actual Go adapter")
+	}
+	for _, service := range []string{"bot-a", "bot-b"} {
+		transport, policy, closeTrace, err := newUI188MC12Heartbeat(service, http.DefaultTransport)
+		if err != nil || transport == nil || policy == nil {
+			t.Fatal("actual constructor failed", err)
+		}
+		closeTrace()
+		if _, _, closeAgain, err := newUI188MC12Heartbeat(service, http.DefaultTransport); err == nil {
+			closeAgain()
+			t.Fatal("duplicate producer accepted")
+		}
+	}
+	for _, wrong := range []string{"cb16-bot-a", "other-service", "", "worker-a"} {
+		if _, _, closeTrace, err := newUI188MC12Heartbeat(wrong, http.DefaultTransport); err == nil {
+			closeTrace()
+			t.Fatal("wrong service accepted")
+		}
+	}
+	for _, item := range [][2]string{{"UI188_PROBE_ATTEMPT", "cb16r"}, {"UI188_WAIT_CALLER_RUN_ID", "b49f7c83-06bd-4bde-9ca8-e5e0c8b5073b"},
+		{"UI188_DB_SCHEMA", "ui188_cb16r_trial3_20261019"}, {"UI188_GITHUB_RUN_ID", "1"}, {"UI188_GITHUB_RUN_ATTEMPT", "2"}, {"UI188_RUN_IDENTITY", ""}, {"UI188_IDENTITY_SHA256", ""}} {
+		t.Run(item[0], func(t *testing.T) {
+			t.Setenv(item[0], item[1])
+			if ui188HBContext(root, caseID, schema, run) {
+				t.Fatal("wrong or missing environment accepted")
+			}
+		})
+	}
+	raw, err := os.ReadFile(filepath.Join(root, "identity.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	duplicate := bytes.Replace(raw, []byte(`"schema_version":2`), []byte(`"schema_version":2,"schema_version":2`), 1)
+	if bytes.Equal(raw, duplicate) || ui188ActionsUniqueJSON(duplicate) {
+		t.Fatal("duplicate JSON identity accepted")
+	}
+	for _, item := range []struct {
+		name   string
+		mutate func(*ui188ActionsRun)
+	}{
+		{"legacy-scope", func(v *ui188ActionsRun) { v.Scope = "UI188_CB16_DIAGNOSTIC" }},
+		{"wrong-uuid", func(v *ui188ActionsRun) { v.UUID = "b49f7c83-06bd-4bde-9ca8-e5e0c8b5073b" }},
+		{"wrong-schema", func(v *ui188ActionsRun) { v.Schema = "ui188_cb16r_trial3_20261019" }},
+		{"wrong-case", func(v *ui188ActionsRun) { v.Case = "cb16r" }},
+		{"wrong-service", func(v *ui188ActionsRun) { v.Services["bot-a"] = "cb16-bot-a" }},
+		{"attempt-two", func(v *ui188ActionsRun) { v.Attempt = 2 }},
+		{"missing-source", func(v *ui188ActionsRun) { delete(v.Sources, "cp") }},
+		{"future-start", func(v *ui188ActionsRun) { v.StartedNS = time.Now().Add(time.Hour).UnixNano() }},
+	} {
+		t.Run(item.name, func(t *testing.T) {
+			var changed ui188ActionsRun
+			if err := json.Unmarshal(raw, &changed); err != nil {
+				t.Fatal(err)
+			}
+			item.mutate(&changed)
+			bad, err := json.Marshal(changed)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if err := os.WriteFile(filepath.Join(root, "identity.json"), bad, 0600); err != nil {
+				t.Fatal(err)
+			}
+			t.Cleanup(func() {
+				if err := os.WriteFile(filepath.Join(root, "identity.json"), raw, 0600); err != nil {
+					t.Fatal(err)
+				}
+			})
+			digest := sha256.Sum256(bad)
+			t.Setenv("UI188_IDENTITY_SHA256", hex.EncodeToString(digest[:]))
+			if ui188HBContext(root, caseID, schema, run) {
+				t.Fatal("changed manifest accepted by actual context gate")
+			}
+		})
+	}
+	t.Run("duplicate-json-with-matching-digest", func(t *testing.T) {
+		if err := os.WriteFile(filepath.Join(root, "identity.json"), duplicate, 0600); err != nil {
+			t.Fatal(err)
+		}
+		t.Cleanup(func() {
+			if err := os.WriteFile(filepath.Join(root, "identity.json"), raw, 0600); err != nil {
+				t.Fatal(err)
+			}
+		})
+		digest := sha256.Sum256(duplicate)
+		t.Setenv("UI188_IDENTITY_SHA256", hex.EncodeToString(digest[:]))
+		if ui188HBContext(root, caseID, schema, run) {
+			t.Fatal("duplicate identity accepted by actual context gate")
+		}
+	})
+	t.Run("case-alias-json-with-matching-digest", func(t *testing.T) {
+		alias := bytes.Replace(raw, []byte(`"scope":`), []byte(`"Scope":`), 1)
+		if bytes.Equal(alias, raw) {
+			t.Fatal("identity anchor missing")
+		}
+		if err := os.WriteFile(filepath.Join(root, "identity.json"), alias, 0600); err != nil {
+			t.Fatal(err)
+		}
+		t.Cleanup(func() {
+			if err := os.WriteFile(filepath.Join(root, "identity.json"), raw, 0600); err != nil {
+				t.Fatal(err)
+			}
+		})
+		digest := sha256.Sum256(alias)
+		t.Setenv("UI188_IDENTITY_SHA256", hex.EncodeToString(digest[:]))
+		if ui188HBContext(root, caseID, schema, run) {
+			t.Fatal("case alias accepted by actual context gate")
+		}
+	})
+	if ui188HBContext(root, "cb16r", "ui188_cb16r_trial3_20261019", "b49f7c83-06bd-4bde-9ca8-e5e0c8b5073b") {
+		t.Fatal("old run accepted")
+	}
+	proof, err := json.Marshal(map[string]any{"schema_version": 1, "actual_constructor": true, "accepted_services": []string{"bot-a", "bot-b"}, "legacy_rejected": true,
+		"identity_sha256": os.Getenv("UI188_IDENTITY_SHA256"), "run_uuid": run, "case": caseID, "schema": schema, "github_run_id": os.Getenv("UI188_GITHUB_RUN_ID"), "github_run_attempt": 1})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(root, "go-constructor-proof.json"), append(proof, '\n'), 0600); err != nil {
+		t.Fatal(err)
+	}
+}
