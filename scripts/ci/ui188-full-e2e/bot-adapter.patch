--- /dev/null
+++ b/cmd/discord-bot/ui188_cb16_refresh_linux_test.go
@@ -0,0 +1,148 @@
+//go:build linux && ui188_chain
+
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"net/http"
+	"sync"
+	"time"
+
+	"github.com/example/autostream-discord-bot/internal/control"
+	"github.com/example/autostream-discord-bot/internal/jobs"
+)
+
+const ui188CB16RefreshInterval = time.Second
+const ui188CB16RefreshMaxTicks = 3
+const ui188CB16AssignmentConflictCode = "current_discord_binding_assignment_conflict"
+
+// The callback follows runRuntimeConfigRefreshLoop's product policy exactly;
+// the surrounding test policy only bounds admission and records convergence.
+// It never changes a response or retries a mutation/secret resolver.
+func ui188CB16RefreshOnce(ctx context.Context, client control.Client, manager *jobs.Manager, trace func(control.RuntimeConfig, *jobs.Manager, string, bool)) (control.RuntimeConfig, error) {
+	var applied control.RuntimeConfig
+	err := manager.RefreshRuntimeConfig(func() error {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		cfg, err := client.RuntimeConfig(ctx)
+		if err != nil {
+			var rejected control.ControlPanelError
+			if errors.Is(err, control.ErrInvalidCurrentDiscordBinding) || errors.As(err, &rejected) && (rejected.StatusCode == http.StatusUnauthorized || rejected.StatusCode == http.StatusForbidden) {
+				manager.SetStreamVoiceDefaults(nil)
+				manager.GatewayProfileForAssignments(nil, nil, true)
+				_ = manager.ReconcileGatewayCredential("", false, nil)
+			}
+			return err
+		}
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		if trace != nil {
+			trace(cfg, manager, "before", false)
+		}
+		if err := reconcileRuntimeGateway(ctx, client, manager, cfg); err != nil {
+			manager.SetStreamVoiceDefaults(nil)
+			if trace != nil {
+				trace(cfg, manager, "after", true)
+			}
+			return err
+		}
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		applyRuntimeConfigToManager(manager, cfg, reconnectPolicyFromEnv())
+		if trace != nil {
+			trace(cfg, manager, "after", false)
+		}
+		applied = cfg
+		return nil
+	})
+	return applied, err
+}
+
+type ui188CB16RefreshPolicy struct {
+	mu              sync.Mutex
+	maxTicks        int
+	window          time.Duration
+	deadline        time.Time
+	errors          int
+	pending, failed bool
+	last            control.RuntimeConfig
+	lastApplied     time.Time
+}
+
+func newUI188CB16RefreshPolicy(httpTimeout time.Duration) *ui188CB16RefreshPolicy {
+	return &ui188CB16RefreshPolicy{maxTicks: ui188CB16RefreshMaxTicks, window: ui188CB16RefreshMaxTicks * (httpTimeout + ui188CB16RefreshInterval)}
+}
+
+func (p *ui188CB16RefreshPolicy) Observe(cfg control.RuntimeConfig, err error, now time.Time) {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if p.failed {
+		return
+	}
+	if p.pending && !now.Before(p.deadline) {
+		p.failed = true
+		p.pending = false
+		return
+	}
+	if err == nil {
+		p.pending = false
+		p.errors = 0
+		p.deadline = time.Time{}
+		p.last = cfg
+		p.lastApplied = now
+		return
+	}
+	var rejected control.ControlPanelError
+	if !errors.As(err, &rejected) || rejected.StatusCode != http.StatusInternalServerError || rejected.Code != ui188CB16AssignmentConflictCode {
+		p.failed = true
+		p.pending = false
+		return
+	}
+	if !p.pending {
+		p.deadline = now.Add(p.window)
+	}
+	p.errors++
+	p.pending = p.errors < p.maxTicks
+	p.failed = !p.pending
+}
+
+func (p *ui188CB16RefreshPolicy) CanAwait() bool {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	return p.pending && !p.failed
+}
+
+func (p *ui188CB16RefreshPolicy) Failed() bool {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	return p.failed
+}
+
+// This is a test readiness oracle, never a product authority or start grant.
+// The runner supplies the independent canonical CP assignment readback.
+func (p *ui188CB16RefreshPolicy) MatchesExpected(expected control.RuntimeConfig) bool {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if p.pending || p.failed || p.lastApplied.IsZero() || p.last.CurrentDiscordBindings == nil || expected.CurrentDiscordBindings == nil || p.last.Service.ServiceID != expected.Service.ServiceID || p.last.Service.CurrentStreamID != expected.Service.CurrentStreamID {
+		return false
+	}
+	a, e1 := json.Marshal(p.last.CurrentDiscordBindings)
+	b, e2 := json.Marshal(expected.CurrentDiscordBindings)
+	x, e3 := json.Marshal(p.last.Assignments)
+	y, e4 := json.Marshal(expected.Assignments)
+	return e1 == nil && e2 == nil && e3 == nil && e4 == nil && string(a) == string(b) && string(x) == string(y)
+}
+
+func (p *ui188CB16RefreshPolicy) Status() map[string]any {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	return map[string]any{"pending": p.pending, "failed": p.failed, "errors_since_convergence": p.errors,
+		"last_applied_at": p.lastApplied, "service_id": p.last.Service.ServiceID, "current_stream_id": p.last.Service.CurrentStreamID,
+		"assignments": p.last.Assignments, "current_discord_bindings": p.last.CurrentDiscordBindings,
+		"canonical_confirmation": "INDEPENDENT_RUNNER_READBACK_REQUIRED", "max_ticks": p.maxTicks, "window_seconds": p.window.Seconds()}
+}
