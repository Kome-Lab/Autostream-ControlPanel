+		policy.Observe(cfg, err, time.Now())
+		return err
+	}
+	if err := step(); err != nil || !policy.MatchesExpected(a) {
+		t.Fatal("initial real client/manager refresh failed")
+	}
+	before := resolves.Load()
+	err := step()
+	var rejected control.ControlPanelError
+	if !errors.As(err, &rejected) || rejected.StatusCode != 500 || rejected.Code != ui188CB16AssignmentConflictCode || !policy.CanAwait() || policy.MatchesExpected(a) || policy.MatchesExpected(b) || resolves.Load() != before {
+		t.Fatal("classified500 was hidden, reused as readiness or retried resolver")
